# =====================================================================
# EcoTech API — configuração
# Copie para .env (cp .env.example .env) e preencha. O .env NUNCA vai para
# o GitHub (já está no .gitignore): ele guarda senhas.
# =====================================================================

APP_NAME=EcoTech
APP_ENV=local
# Gerada por: php artisan key:generate
APP_KEY=
# true só no seu computador. Em produção: false (senão os erros mostram detalhes internos)
APP_DEBUG=true
# Endereço da API (em produção, com https://)
APP_URL=http://127.0.0.1:8000
# (o idioma fica fixo em pt_BR no config/app.php: APP_LOCALE não é usado)
# (o fuso horário fica fixo em America/Sao_Paulo no config/app.php; a API devolve as datas em UTC + texto em horário de Brasília)

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ── Banco de dados ───────────────────────────────────────────────
# MySQL/MariaDB (XAMPP: usuário root, sem senha; crie antes o banco "ecotech"
# no phpMyAdmin com utf8mb4_unicode_ci)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ecotech
DB_USERNAME=root
DB_PASSWORD=
# Aiven (MySQL na nuvem): use host, porta, usuário e senha do painel do Aiven,
# um banco SÓ do EcoTech (ex.: ecotech) e o certificado CA baixado do painel:
# MYSQL_ATTR_SSL_CA=C:/caminho/ca.pem
# Sem MySQL instalado? Para testar rápido, use SQLite:
# DB_CONNECTION=sqlite
# DB_DATABASE=C:/caminho/completo/database/database.sqlite

# Banco ANTIGO, só para importar dados com: php artisan ecotech:importar-legado
# (ou importe os JSON da MockAPI: php artisan ecotech:importar-legado --mockapi=pasta)
# LEGADO_DB_HOST=
# LEGADO_DB_PORT=3306
# LEGADO_DB_DATABASE=defaultdb
# LEGADO_DB_USERNAME=
# LEGADO_DB_PASSWORD=
# LEGADO_MYSQL_ATTR_SSL_CA=C:/caminho/ca.pem

# ── Cache, sessão e filas (a API não usa cookies; "file" funciona em qualquer hospedagem)
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# ── EcoTech ──────────────────────────────────────────────────────
# Segredo da assinatura dos QR Codes dos Ecopontos. Gere um valor longo e
# aleatório (ex.: php -r "echo bin2hex(random_bytes(32));") e NÃO troque
# depois: trocar invalida todas as placas impressas.
QR_SECRET=

# Código de 6 dígitos por e-mail (cadastro, login e "esqueci a senha"), enviado pelo Resend.
# Sem RESEND_API_KEY o e-mail não sai: o código aparece em storage/logs/laravel.log.
# "onboarding@resend.dev" só entrega para o e-mail dono da conta do Resend;
# para mandar para qualquer pessoa, verifique um domínio no Resend e troque o remetente.
RESEND_API_KEY=
EMAIL_REMETENTE="EcoTech <onboarding@resend.dev>"
# Código fixo das contas de exemplo do seed (e-mails ".example", que não recebem e-mail)
CODIGO_DEMO=123456
# true = deixa o DemoSeeder (pessoas com histórico) rodar no servidor de produção
SEED_DEMO_PRODUCAO=false

# Endereços do front que podem chamar a API, separados por vírgula
CORS_ORIGINS=https://eco-tech-blush.vercel.app
# true = libera também http://localhost:* e http://127.0.0.1:* (Live Server). Em produção: false
CORS_LOCALHOST=true

# Regra de senha das pessoas: "forte" = 8+ com maiúscula, minúscula e número
# (decisão do grupo, a mesma regra do front) ou "enunciado" = exatamente 8 letras
# (regra do PDF do trabalho; o front teria de mudar junto).
# Empresas sempre usam a regra forte.
SENHA_REGRA=forte

# Validade do token: 8 horas; 30 dias quando a pessoa marca "lembrar"
TOKEN_HORAS=8
TOKEN_LEMBRAR_DIAS=30

# Open Food Facts (consulta dos códigos de barras) e ViaCEP
OFF_BASE_URL=https://world.openfoodfacts.org
OFF_TIMEOUT=4
VIACEP_URL=https://viacep.com.br/ws

# Login com Google: o mesmo Client ID usado no front (Google Cloud Console >
# Credenciais > ID do cliente OAuth). Vazio = login com Google desligado (503)
GOOGLE_CLIENT_ID=

# ── Master (administrador) ───────────────────────────────────────
# Criado por: php artisan migrate --seed  ou  php artisan ecotech:criar-master
# A senha segue a SENHA_REGRA (no padrão: forte, ex.: Master123). NUNCA coloque no código.
MASTER_PASSWORD=
MASTER_EMAIL=master@ecotech.com
MASTER_LOGIN=MASTER
MASTER_NOME="Administrador Master EcoTech"
MASTER_CPF=52998224725
# Respostas da pergunta de segurança (2FA) do master: troque pelas suas
MASTER_NOME_MAE="Maria da Silva"
MASTER_NASCIMENTO=2000-01-01
MASTER_CEP=20040020

# ── Dados de exemplo ─────────────────────────────────────────────
# Senha das 3 empresas fictícias do seed (contato@costaverde.ecotech.example etc.)
SEED_EMPRESA_PASSWORD=Ecotech2026
# Senha das pessoas de demonstração (php artisan db:seed --class=DemoSeeder)
SEED_DEMO_PASSWORD=Reciclar1
